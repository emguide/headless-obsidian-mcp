{
  "mcpServers": {
    "obsidian": {
      "command": "node",
      "args": ["/absolute/path/to/headless-obsidian-mcp/dist/index.js"],
      "env": {
        "OBSIDIAN_VAULT_PATH": "/absolute/path/to/your/obsidian/vault",
        "OBSIDIAN_TOOLS": "all",
        "OBSIDIAN_GIT_SYNC": "commit"
      }
    }
  }
}
