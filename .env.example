# Headless Obsidian MCP — every environment variable the server reads.
#
# NOTE: nothing in this project loads a .env file. There is no dotenv
# dependency, by design — an MCP server is spawned by its client, so these
# variables arrive from the client's own `env` block (see examples/), your
# shell, mise, or `docker run --env-file`. This file is documentation, and
# `--env-file` fodder for the Docker image. Copying it to `.env` does nothing
# on its own.

# --- required ---------------------------------------------------------------

# Absolute path to the Obsidian vault. The only variable with no default; the
# server refuses to start without it. In the Docker image this defaults to the
# /vault mount point.
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# --- tool exposure ----------------------------------------------------------

# Which tools the server exposes, as a comma-separated selector list evaluated
# left to right (a plain token adds, a `-` prefix subtracts). Unset means the
# policy `reads`: a read-only server with all 21 write tools hidden from
# list_tools and rejected if called.
#
#   all                              everything
#   -templates,-tasks                reads, minus those groups
#   reads,tasks.write,sections.write read all, write tasks + sections
#   all,-bulk,-delete_note           everything but the scary ones
#   search,notes.read                minimal search-and-read agent
#
# An unknown selector, or a policy selecting no tools, aborts startup.
# get_config is groupless and always exposed, so an agent can always discover
# why a tool is absent.
#OBSIDIAN_TOOLS=all

# TRAP: OBSIDIAN_ALLOW_WRITES is retired. Setting it *at all* — to any value,
# including 0 — aborts startup with a migration hint. Use OBSIDIAN_TOOLS=all
# wherever you previously set OBSIDIAN_ALLOW_WRITES=1. Listed here only so the
# failure is recognizable; leave it unset.
#OBSIDIAN_ALLOW_WRITES=

# --- git sync ---------------------------------------------------------------

# off (default) | commit | every-write | timer
#
#   off          no git involvement
#   commit       commit each write immediately, no remote interaction
#   every-write  commit, then pull (merge) + push the remote after every write
#   timer        commit; a background interval pulls + pushes on a cadence
#
# In any mode other than off the contract is fail-closed: a write is refused
# before touching the filesystem if the vault is not a usable git repository,
# and the post-write commit throws if it fails — a write never lands without
# its snapshot. The one exception is the background timer's own tick, which
# records its failure in get_config's sync.last_error instead of throwing.
#
# Requires the `git` binary. Merge conflicts are resolved non-destructively
# into `<note> (conflicted YYYY-MM-DD HHMMSS)` copies; find them with
# list_vault_issues kind:"conflicts".
#OBSIDIAN_GIT_SYNC=commit

# Seconds between background syncs in `timer` mode. Default 300, floored at 1.
# Ignored in every other mode.
#OBSIDIAN_GIT_SYNC_INTERVAL=300

# Remote to pull/push in `every-write` and `timer` modes. Default origin.
#OBSIDIAN_GIT_REMOTE=origin

# TRAP: OBSIDIAN_GIT_AUTOCOMMIT is the deprecated predecessor. Setting it
# truthy still works, but warns on startup and maps to
# OBSIDIAN_GIT_SYNC=commit. An explicit OBSIDIAN_GIT_SYNC always wins.
#OBSIDIAN_GIT_AUTOCOMMIT=1

# --- headless overrides for Obsidian plugin config --------------------------
#
# Both tool families read the plugin's own config file first, so they track
# whatever you set inside Obsidian. These override the folder for setups where
# that config isn't present.

# Overrides the core Templates plugin's folder (.obsidian/templates.json).
# With neither the config file nor this variable, the template tools fail loud
# rather than reporting zero templates. Vault-relative.
#OBSIDIAN_TEMPLATE_FOLDER=Templates

# Overrides the Daily Notes plugin's folder (.obsidian/daily-notes.json).
# With neither present, resolve_daily_note fails loud rather than guessing a
# path. Vault-relative; the empty string means the vault root.
#OBSIDIAN_DAILY_FOLDER=Daily
