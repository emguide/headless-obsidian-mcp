{
  "name": "headless-obsidian-mcp",
  "version": "1.0.0",
  "description": "Headless MCP server for interacting with Obsidian vaults",
  "type": "module",
  "bin": {
    "headless-obsidian-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "query": "tsx src/query-cli.ts",
    "prepare": "tsc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.0.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
